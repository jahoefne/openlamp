{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  // The CLI and the tests run src/core directly under Node (type stripping).
  "include": ["cli", "tests", "vite.config.ts", "vitest.config.ts", "src/core"]
}
