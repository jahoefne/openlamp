// src/core runs unchanged in the worker, the CLI and Vitest. Checking it with
// the plain ES library and no ambient @types proves it touches no DOM, worker
// or Node globals.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/core"]
}
