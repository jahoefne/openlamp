{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  // src/core is included because the app imports it; tsconfig.core.json is
  // what proves it DOM-free.
  "include": ["src"],
  "exclude": ["src/worker.ts", "src/worker/**"]
}
