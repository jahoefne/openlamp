{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  // src/core is included because the app imports it; tsconfig.core.json is
  // what proves it DOM-free. The worker is checked by tsconfig.worker.json (the
  // app still sees the types of src/worker/protocol.ts through its imports).
  "include": ["src"],
  "exclude": ["src/worker"]
}
